 "fields": [
  {
   "fieldname": "order_settings_tab",
   "fieldtype": "Tab Break",
   "label": "Order Settings"
  },
  {
   "fieldname": "order_api_section",
   "fieldtype": "Section Break",
   "label": "Order API"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "0"
  },
  {
   "fieldname": "create_order_url",
   "fieldtype": "Data",
   "label": "Create Order URL",
   "reqd": 1
  },
  {
   "fieldname": "tracking_url",
   "fieldtype": "Data",
   "label": "Tracking URL",
   "depends_on": "eval:doc.enable_manual_tracking_refresh",
   "mandatory_depends_on": "eval:doc.enable_manual_tracking_refresh"
  },
  {
   "fieldname": "enable_manual_tracking_refresh",
   "fieldtype": "Check",
   "label": "Enable Manual Tracking Refresh",
   "default": "0",
   "description": "Show and allow the manual Refresh Shipment Status action."
  },
  {
   "fieldname": "order_defaults_section",
   "fieldtype": "Section Break",
   "label": "Order Defaults"
  },
  {
   "fieldname": "pickup_address",
   "fieldtype": "Data",
   "label": "Pickup Address",
   "reqd": 1
  },
  {
   "fieldname": "order_channel",
   "fieldtype": "Data",
   "label": "Order Channel",
   "default": "Custom",
   "reqd": 1
  },
  {
   "fieldname": "order_defaults_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "default_parcel_length",
   "fieldtype": "Float",
   "label": "Default Parcel Length",
   "default": "1"
  },
  {
   "fieldname": "default_parcel_breadth",
   "fieldtype": "Float",
   "label": "Default Parcel Breadth",
   "default": "1"
  },
  {
   "fieldname": "default_parcel_height",
   "fieldtype": "Float",
   "label": "Default Parcel Height",
   "default": "1"
  },
  {
   "fieldname": "default_dead_weight",
   "fieldtype": "Float",
   "label": "Default Dead Weight",
   "default": "0.1"
  },
  {
   "fieldname": "order_credentials_section",
   "fieldtype": "Section Break",
   "label": "Credentials"
  },
  {
   "fieldname": "api_key",
   "fieldtype": "Password",
   "label": "API Key",
   "reqd": 1
  },
  {
   "fieldname": "api_secret",
   "fieldtype": "Password",
   "label": "API Secret",
   "reqd": 1
  },
  {
   "fieldname": "order_credentials_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "enable_webhook_security",
   "fieldtype": "Check",
   "label": "Enable Webhook Security",
   "default": "1"
  },
  {
   "fieldname": "webhook_secret",
   "fieldtype": "Password",
   "label": "Webhook Secret",
   "depends_on": "eval:doc.enable_webhook_security",
   "mandatory_depends_on": "eval:doc.enable_webhook_security",
   "description": "Secret key for validating incoming webhooks"
  },
  {
   "fieldname": "support_ticket_settings_tab",
   "fieldtype": "Tab Break",
   "label": "Support Ticket Settings"
  },
  {
   "fieldname": "support_ticket_api_section",
   "fieldtype": "Section Break",
   "label": "Support Ticket API"
  },
  {
   "fieldname": "enable_support_ticket",
   "fieldtype": "Check",
   "label": "Enable Support Ticket",
   "default": "0",
   "description": "Show support ticket actions and allow support ticket API/webhook processing."
  },
  {
   "fieldname": "support_create_url",
   "fieldtype": "Data",
   "label": "Support Create URL",
   "depends_on": "eval:doc.enable_support_ticket",
   "description": "Shipkia create support ticket API endpoint"
  },
  {
   "fieldname": "support_update_url",
   "fieldtype": "Data",
   "label": "Support Update URL",
   "depends_on": "eval:doc.enable_support_ticket",
   "description": "Reserved for future support ticket update API calls."
  },
  {
   "fieldname": "support_get_url",
   "fieldtype": "Data",
   "label": "Support Get URL",
   "depends_on": "eval:doc.enable_support_ticket",
   "description": "Shipkia get support ticket API endpoint"
  },
  {
   "fieldname": "support_list_url",
   "fieldtype": "Data",
   "label": "Support List URL",
   "depends_on": "eval:doc.enable_support_ticket",
   "description": "Reserved for future support ticket list API calls."
  },
  {
   "fieldname": "whatsapp_notifications_tab",
   "fieldtype": "Tab Break",
   "label": "WhatsApp Notifications"
  },
  {
   "fieldname": "whatsapp_notification_controls",
   "fieldtype": "Section Break",
   "label": "Notification Setup"
  },
  {
   "fieldname": "whatsapp_notification_intro",
   "fieldtype": "HTML",
   "options": "<div class=\"alert alert-info\">Messages use approved Interakt templates. Routing checks an existing Patient conversation first, then department/default pipeline maps, and finally the optional fallback account.</div>"
  },
  {
   "default": "Legacy Shipment Tracking",
   "description": "Choose exactly one owner for automated shipment notifications. Existing sites remain on the legacy engine until explicitly switched.",
   "fieldname": "whatsapp_notification_engine",
   "fieldtype": "Select",
   "label": "WhatsApp Notification Engine",
   "options": "Legacy Shipment Tracking\nPatient Notification Hub",
   "reqd": 1
  },
  {
   "depends_on": "eval:doc.whatsapp_notification_engine=='Patient Notification Hub'",
   "fieldname": "patient_notification_hub_status",
   "fieldtype": "HTML",
   "options": "<div class=\"alert alert-warning\">Patient Notification Hub owns these events. Legacy creation and retry jobs are disabled; manage rules and delivery from the Hub workspace.</div>"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.whatsapp_notification_engine=='Legacy Shipment Tracking'",
   "description": "Master switch for the three legacy automated patient notifications configured below.",
   "fieldname": "enable_whatsapp_notifications",
   "fieldtype": "Check",
   "label": "Enable Automated WhatsApp Notifications"
  },
  {
   "default": "1",
   "depends_on": "eval:doc.enable_whatsapp_notifications",
   "description": "Recommended during setup. Creates notification audit records without sending messages to Interakt.",
   "fieldname": "whatsapp_dry_run",
   "fieldtype": "Check",
   "label": "Dry Run (Do Not Send)"
  },
  {
   "fieldname": "whatsapp_notification_control_column",
   "fieldtype": "Column Break"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.enable_whatsapp_notifications",
   "description": "Send when a Sales Invoice is submitted.",
   "fieldname": "enable_sales_invoice_generated",
   "fieldtype": "Check",
   "label": "Enable Sales Invoice Generated"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.enable_whatsapp_notifications",
   "description": "Send when Shipkia reports that the shipment was picked up.",
   "fieldname": "enable_order_picked_up",
   "fieldtype": "Check",
   "label": "Enable Order Picked Up"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.enable_whatsapp_notifications",
   "description": "Send when Shipkia reports that the shipment is out for delivery.",
   "fieldname": "enable_out_for_delivery",
   "fieldtype": "Check",
   "label": "Enable Out for Delivery"
  },
  {
   "fieldname": "whatsapp_fallback_section",
   "fieldtype": "Section Break",
   "label": "Account Routing",
   "depends_on": "eval:doc.enable_whatsapp_notifications"
  },
  {
   "default": "0",
   "depends_on": "eval:doc.enable_whatsapp_notifications",
   "description": "Use the selected Interakt account only when normal Patient routing cannot resolve an account.",
   "fieldname": "enable_default_interakt_fallback",
   "fieldtype": "Check",
   "label": "Enable Default Interakt Fallback"
  },
  {
   "depends_on": "eval:doc.enable_whatsapp_notifications && doc.enable_default_interakt_fallback",
   "description": "Final fallback only. Existing conversations and Patient department mappings take precedence.",
   "fieldname": "default_interakt_account",
   "fieldtype": "Link",
   "label": "Default Interakt Account",
   "mandatory_depends_on": "eval:doc.enable_whatsapp_notifications && doc.enable_default_interakt_fallback",
   "options": "Chat Channel Account"
  },
  {
   "fieldname": "whatsapp_invoice_template_section",
   "fieldtype": "Section Break",
   "label": "1. Sales Invoice Generated",
   "depends_on": "eval:doc.enable_whatsapp_notifications"
  },
  {
   "default": "sales_invoice_generated",
   "depends_on": "eval:doc.enable_sales_invoice_generated",
   "description": "Approved template name in Interakt.",
   "fieldname": "sales_invoice_generated_template",
   "fieldtype": "Data",
   "label": "Interakt Template Name",
   "mandatory_depends_on": "eval:doc.enable_sales_invoice_generated"
  },
  {
   "fieldname": "whatsapp_invoice_template_column",
   "fieldtype": "Column Break"
  },
  {
   "default": "en",
   "depends_on": "eval:doc.enable_sales_invoice_generated",
   "description": "Interakt template language code, for example en.",
   "fieldname": "sales_invoice_generated_language",
   "fieldtype": "Data",
   "label": "Language Code",
   "mandatory_depends_on": "eval:doc.enable_sales_invoice_generated"
  },
  {
   "fieldname": "whatsapp_shipment_template_section",
   "fieldtype": "Section Break",
   "label": "2. Order Picked Up",
   "depends_on": "eval:doc.enable_whatsapp_notifications"
  },
  {
   "default": "order_picked_up",
   "depends_on": "eval:doc.enable_order_picked_up",
   "description": "Approved template name in Interakt.",
   "fieldname": "order_picked_up_template",
   "fieldtype": "Data",
   "label": "Interakt Template Name",
   "mandatory_depends_on": "eval:doc.enable_order_picked_up"
  },
  {
   "default": "en",
   "depends_on": "eval:doc.enable_order_picked_up",
   "description": "Interakt template language code, for example en.",
   "fieldname": "order_picked_up_language",
   "fieldtype": "Data",
   "label": "Language Code",
   "mandatory_depends_on": "eval:doc.enable_order_picked_up"
  },
  {
   "fieldname": "whatsapp_shipment_template_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "whatsapp_out_for_delivery_section",
   "fieldtype": "Section Break",
   "label": "3. Out for Delivery",
   "depends_on": "eval:doc.enable_whatsapp_notifications"
  },
  {
   "default": "out_for_delivery",
   "depends_on": "eval:doc.enable_out_for_delivery",
   "description": "Approved template name in Interakt.",
   "fieldname": "out_for_delivery_template",
   "fieldtype": "Data",
   "label": "Interakt Template Name",
   "mandatory_depends_on": "eval:doc.enable_out_for_delivery"
  },
  {
   "fieldname": "whatsapp_out_for_delivery_column",
   "fieldtype": "Column Break"
  },
  {
   "default": "en",
   "depends_on": "eval:doc.enable_out_for_delivery",
   "description": "Interakt template language code, for example en.",
   "fieldname": "out_for_delivery_language",
   "fieldtype": "Data",
   "label": "Language Code",
   "mandatory_depends_on": "eval:doc.enable_out_for_delivery"
  },
  {
   "fieldname": "whatsapp_delivery_section",
   "fieldtype": "Section Break",
   "label": "Rollout and Retry",
   "depends_on": "eval:doc.enable_whatsapp_notifications"
  },
  {
   "description": "Optional safety filter. When selected, only this Patient can generate notification records; leave blank for all Patients.",
   "fieldname": "whatsapp_test_patient",
   "fieldtype": "Link",
   "label": "Pilot Patient",
   "options": "Patient"
  },
  {
   "fieldname": "whatsapp_delivery_column",
   "fieldtype": "Column Break"
  },
  {
   "default": "3",
   "description": "Total send attempts before the notification is marked Failed.",
   "fieldname": "whatsapp_max_retries",
   "fieldtype": "Int",
   "label": "Maximum Attempts"
  },
  {
   "default": "5",
   "description": "Minutes before retrying a failed Interakt request.",
   "fieldname": "whatsapp_retry_delay_minutes",
   "fieldtype": "Int",
   "label": "Base Retry Delay (Minutes)"
  }
 ],
 "index_web_pages_for_search": 1,
 "issingle": 1,
 "links": [],
